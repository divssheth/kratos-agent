# ============================================================================
# GitHub Copilot Token (Required)
# ============================================================================
# Get one at: https://github.com/settings/tokens
# Create with public repo read access (no other scopes needed)
COPILOT_GITHUB_TOKEN=

# ============================================================================
# Local Development Mode (Optional)
# ============================================================================
# Set to 'false' to test OBO flow (requires Entra ID configuration below)
# Set to 'true' to force Agent SP mode (default for local development)
# LOCAL_MODE=true

# ============================================================================
# Power BI OBO Feature Flags (Optional - default OFF)
# ============================================================================
# Flip to 'true' to enable OBO mode (requires full Entra ID config)
# Note: In LOCAL_MODE=true, this flag is ignored
# ENABLE_USER_AUTH_OBO=false
# ENABLE_POWERBI_FABRIC_MCP=false
# ENABLE_WORKSPACE_SELECTOR=false

# ============================================================================
# Azure Entra ID Configuration (Optional - for OBO testing)
# ============================================================================
# Only needed if you want to test OBO mode with real Azure authentication
# Leave these empty to use local mode (default)

# Your Azure tenant ID
# AZURE_TENANT_ID=12345678-1234-1234-1234-123456789012

# Service principal client ID (for backend to get access tokens)
# AZURE_CLIENT_ID=87654321-4321-4321-4321-210987654321

# Service principal secret (NEVER hardcode - use Key Vault in production!)
# For local testing only - get from Azure Portal
# AZURE_CLIENT_SECRET=your-secret-here

# Frontend MSAL Configuration (Optional - for real Entra ID testing)
# NEXT_PUBLIC_AZURE_CLIENT_ID=87654321-4321-4321-4321-210987654321
# NEXT_PUBLIC_AZURE_TENANT_ID=12345678-1234-1234-1234-123456789012
